# Copy to .env and fill in. Never commit .env.

# --- LLM serving (OpenAI-compatible endpoint; Ollama by default) ---
PATCHPILOT_LLM_BASE_URL=http://localhost:11434/v1
PATCHPILOT_LLM_API_KEY=
PATCHPILOT_LLM_MODEL=

# --- Hugging Face (dataset downloads, pushing trained adapters) ---
HF_TOKEN=

# --- Optional reference baseline (G1) ---
GEMINI_API_KEY=

# --- Optional experiment tracking ---
MLFLOW_TRACKING_URI=
WANDB_API_KEY=

# --- GitHub bot (S4); in GitHub Actions this is provided automatically ---
GITHUB_TOKEN=
